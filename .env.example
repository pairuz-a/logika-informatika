# ===== Server =====
PORT=3000
# Batas panjang materi yang dikirim ke model (karakter). Makin besar makin boros token.
MAX_MATERIAL_CHARS=60000
# Batas permintaan per IP per menit (biar kuota API nggak jebol)
RATE_LIMIT_PER_MIN=20
# Opsional: kalau diisi, user harus memasukkan password ini di web. Pakai kalau dibuka ke teman-teman.
APP_PASSWORD=

# ===== Provider =====
# Daftar id provider yang aktif (bebas diberi nama), pisahkan dengan koma.
PROVIDERS=cosmos,mobius,gemini

# --- Provider OpenAI-compatible (contoh: CosmosHub) ---
# Base URL = alamat sebelum /chat/completions, biasanya berakhiran /v1
COSMOS_TYPE=openai
COSMOS_LABEL=CosmosHub
COSMOS_BASE_URL=https://GANTI-DENGAN-BASE-URL-COSMOS/v1
COSMOS_API_KEY=
COSMOS_MODELS=nama-model-1,nama-model-2

# --- Provider OpenAI-compatible lain (contoh: Mobius) ---
MOBIUS_TYPE=openai
MOBIUS_LABEL=Mobius
MOBIUS_BASE_URL=https://GANTI-DENGAN-BASE-URL-MOBIUS/v1
MOBIUS_API_KEY=
MOBIUS_MODELS=nama-model-1

# --- Gemini (API native Google) ---
GEMINI_TYPE=gemini
GEMINI_LABEL=Gemini
GEMINI_API_KEY=
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-pro
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
